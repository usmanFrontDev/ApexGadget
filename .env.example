# Mock data is the default. Set to "false" only when the Shopify values below are filled in.
VITE_USE_MOCK_DATA=true

# Public Storefront API credentials (Headless channel). Leave empty until the store is live.
VITE_SHOPIFY_STORE_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=
# Optional. Defaults to the version in src/constants/shopify.ts.
VITE_SHOPIFY_API_VERSION=

# Support contact form (EmailJS, https://www.emailjs.com). Public values; the recipient address is set in the EmailJS
# template, not here. Leave empty until the EmailJS service + template exist: the form then says it isn't connected.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
